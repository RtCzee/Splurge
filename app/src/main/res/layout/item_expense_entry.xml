<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/dashboard_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/expense_description_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/dashboard_primary_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Lunch with client" />

            <TextView
                android:id="@+id/expense_amount_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dashboard_primary_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="R 245.00" />

        </LinearLayout>

        <TextView
            android:id="@+id/expense_category_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_budget_status_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/dashboard_status_text"
            android:textSize="12sp"
            tools:text="Food" />

        <TextView
            android:id="@+id/expense_date_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/dashboard_muted_text"
            android:textSize="13sp"
            tools:text="27 Apr 2026" />

        <TextView
            android:id="@+id/expense_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/dashboard_muted_text"
            android:textSize="13sp"
            tools:text="12:00 - 13:30" />

        <ImageView
            android:id="@+id/expense_photo_preview"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/expense_photo_preview"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:src="@drawable/ic_launcher_foreground_image"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_photo_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_photo_button"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
