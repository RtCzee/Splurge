<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SplurgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Splurge">
        <activity
            android:name=".FactLoadingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.signup.Signup"
            android:exported="false" />
        <activity
            android:name=".ui.login.Login"
            android:exported="false" />
        <activity
            android:name=".ui.welcome.Welcome"
            android:exported="true" />
        <activity
            android:name=".ui.transactions.Transactions"
            android:exported="false" />
        <activity
            android:name=".ui.bills.Bills"
            android:exported="false" />
        <activity
            android:name=".ui.profile.Profile"
            android:exported="false" />
        <activity
            android:name=".ui.goals.Goals"
            android:exported="false" />
        <activity
            android:name=".ui.budgets.Budgets"
            android:exported="false" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <receiver
            android:name=".notifications.BillReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.BillReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".ui.graph.CategorySpendingGraphActivity"
            android:exported="false" />
    </application>

</manifest>
